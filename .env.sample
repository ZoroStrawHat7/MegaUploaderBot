# Telegram credentials from https://my.telegram.org and @BotFather
APP_ID=123456
API_HASH=your_telegram_api_hash
BOT_TOKEN=123456:your_bot_token
STRING_SESSION=your_private_telegram_session_string

# Your own Telegram numeric user ID. Only this account can use the bot.
AUTH_USERS=123456789

# MEGA account credentials (set as Railway secrets; never commit real values)
MEGA_EMAIL=you@example.com
MEGA_PASSWORD=your_mega_password

# Persistent volume for MEGA config; mount Railway Volume at /data.
DATA_DIR=/data

# Temporary download directory (container disk, not persistent volume).
DOWNLOAD_LOCATION=/tmp/mega-downloads
